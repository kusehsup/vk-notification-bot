# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# Ключ шифрования токенов VK в БД.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Путь к SQLite БД
DB_PATH=data/bot.db

# Интервал поллинга notifications.get в секундах.
# 90+ снижает риск Flood control после ужесточения лимитов VK (сентябрь 2026).
NOTIFICATIONS_POLL_INTERVAL=90

# Интервал поллинга VK ID сессий в секундах (по умолчанию 60 сек)
VKID_POLL_INTERVAL=60

# Минимальная пауза между любыми вызовами api.vk.com/method (секунды)
VK_API_MIN_INTERVAL=0.5

# Начальный cooldown после VK API error 9 Flood control (секунды). Дальше растёт экспоненциально до часа.
VK_FLOOD_COOLDOWN=600

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
